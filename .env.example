# --- source download (yt-dlp) -------------------------------------------------
DOWNLOAD_MAX_HEIGHT=1080      # cap URL downloads (1080 keeps YouTube jobs small/fast;
                              # 0 = uncapped, often a multi-GB 4K file)

# --- transcription -----------------------------------------------------------
WHISPER_MODEL=base.en          # tiny.en | base.en | small.en | medium.en | large-v3
WHISPER_DEVICE=auto            # cpu | cuda | auto
WHISPER_COMPUTE_TYPE=int8      # int8 is fastest on CPU / Apple Silicon
WHISPER_LANGUAGE=              # leave empty to auto-detect

# --- highlight selection -----------------------------------------------------
LLM_PROVIDER=auto              # auto | openai | anthropic | heuristic
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=                # sk-... (only needed for LLM highlight picking)
ANTHROPIC_API_KEY=             # sk-ant-... (only needed for LLM highlight picking)
MAX_HIGHLIGHTS=10               # clips generated per uploaded video
MIN_HIGHLIGHTS=3
MIN_HIGHLIGHT_SECONDS=30
MAX_HIGHLIGHT_SECONDS=60

# --- rendering ---------------------------------------------------------------
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
VIDEO_CRF=20
VIDEO_PRESET=veryfast
AUDIO_BITRATE=160k

# --- captions ----------------------------------------------------------------
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=92
CAPTION_MAX_WORDS=4
CAPTION_MAX_CHARS=18
CAPTION_UPPERCASE=1
CAPTION_POS_Y=1310
CAPTION_PRIMARY=&H00FFFFFF     # words that are not being spoken (ASS &HAABBGGRR)
CAPTION_HIGHLIGHT=&H0000D4FF   # accent colour for the word being spoken
CAPTION_OUTLINE_WIDTH=9

# --- caption mode -------------------------------------------------------------
CAPTION_MODE=animated     # animated = moving word-by-word captions (default)
                          # static   = ONE stationary white box for the whole
                          # clip (big-clip-channel style); text comes from the
                          # UI/CLI/API subtitle field, or is suggested per clip
STATIC_FONT_SIZE=64
STATIC_TEXT_COLOUR=&H00000000   # black text inside the box (ASS &HAABBGGRR)
STATIC_BOX_COLOUR=&H00FFFFFF    # white opaque box

# --- server ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
SHORTS_DATA_DIR=./data

# --- music (optional background track) ----------------------------------------
# Library folder for "AI picks one" mode — drop your own mp3/wav/m4a files here.
# The app never downloads or bundles copyrighted songs.
SHORTS_MUSIC_DIR=./assets/music
MUSIC_VOLUME=0.45      # level of the added track
MUSIC_OFFSET=0.0       # seconds into the track (put the drop here)
ORIGINAL_VOLUME=1.0    # original clip audio (0 = mute speech, music stays)

# --- watermark (optional) ------------------------------------------------------
WATERMARK_PATH=./assets/watermark.png   # replace with your own PNG
WATERMARK_DEFAULT_ON=1                  # 0 = off by default
WATERMARK_WIDTH_FRAC=0.35               # ~35% of video width
WATERMARK_TOP_MARGIN=0.10               # keep out of top 10% (platform UI)
WATERMARK_BOTTOM_MARGIN=0.15            # keep out of bottom 15% (platform UI)

# --- watermark placement ------------------------------------------------------
WATERMARK_DIR=./assets/watermarks      # files dragged in via the UI/API
WATERMARK_POSITION=bottom-center       # top-left | top-right | bottom-left | bottom-right | bottom-center
WATERMARK_H_MARGIN=0.04                # side gap for corner placements (fraction of width)

# --- hook versions + playbook -------------------------------------------------
HOOK_VERSIONS=1           # 1 = every clip also gets a 🪝 flash-forward cold-open cut
HOOK_PLAYBOOK=1           # 1 = write 8 scored hook options + a retention beat sheet per clip
HOOK_PLATFORM=both        # both | shorts | reels

# --- viral analysis (1M+ creator/streamer Shorts patterns) -------------------
VIRAL_ANALYSIS=1          # 1 = score every clip 0–100 against 1M+ Shorts patterns
                          # (open on the moment, 18–35s band, payoff placement,
                          # dead air, loop ending, muted captions, cold-viewer
                          # context, honest ask) with prioritized fixes

# --- publish metadata (Instagram + YouTube) ----------------------------------
PUBLISH_METADATA=1     # 1 = every clip also gets clip_XX_publish.json/.md: a
                          # copy-paste IG caption + hashtag set and a YT
                          # ≤100-char title / tags / description with #shorts,
                          # generated from the clip's own transcript

# --- AI voice (reads the captions aloud) --------------------------------------
TTS_RATE=+8%           # delivery speed
TTS_VOLUME=1.0         # AI voice level
TTS_ORIGINAL_VOLUME=0.15  # original speaker ducked under the AI voice (arena sound kept)

# --- social publishing (link accounts, post clips directly) ------------------
# YouTube: create a Desktop-app OAuth client in Google Cloud (YouTube Data
# API v3 enabled) and paste its id/secret here — or drop the downloaded JSON
# as client_secret.json in the project root. Then click Connect on the
# 🔌 Accounts page (repeat per channel or Instagram account; TikTok uses the
# TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET below).
GOOGLE_CLIENT_ID=                # ….apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json
SOCIAL_REDIRECT_URI=http://127.0.0.1:8000/api/social/youtube/callback  # must match the OAuth client
YT_PRIVACY_STATUS=public         # public | unlisted | private
IG_GRAPH_VERSION=v21.0           # Meta Graph API version
IG_POLL_SECONDS=8                # reel-processing status poll interval
IG_POLL_TIMEOUT=300              # give up waiting for Meta after this many seconds
# Instagram one-click sign-in (recommended): free Business-type Facebook app
# at developers.facebook.com → Create App → add the Instagram Graph API
# product, then paste App ID + App Secret here for "Connect with Facebook"
# and automatic 60-day token refresh. Leave empty to paste tokens manually.
IG_APP_ID=                        # Facebook App ID
IG_APP_SECRET=                    # Facebook App Secret
IG_REDIRECT_URI=http://127.0.0.1:8000/api/social/instagram/callback  # must match the app
# TikTok: register an app on developers.tiktok.com (Content Posting API +
# Login Kit), add the redirect URI below, paste its key/secret here, then
# click Connect on the 🔌 Accounts page (repeat per account).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/social/tiktok/callback  # must match the app config
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE  # SELF_ONLY = private (required while unaudited)
TIKTOK_POLL_SECONDS=6            # publish-status poll interval
TIKTOK_POLL_TIMEOUT=300          # give up waiting for TikTok after this many seconds
